{
  "manifest_version": 3,
  "name": "Claude Conversation Exporter",
  "version": "1.0.0",
  "description": "Export your claude.ai conversations to Markdown, plain text, HTML and raw JSON.",
  "permissions": [
    "downloads",
    "offscreen",
    "storage",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background/worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Export Claude conversations",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  }
}
